<UserControl x:Class="PCL.ClubLaunchPanel"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL">
 <UserControl.Resources>
  <Style x:Key="ClubActionButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
   <Setter Property="Background" Value="{DynamicResource ColorBrushWhite}" />
   <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush4}" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ColorBrush8}" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ColorBrush7}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style x:Key="DestinationButton" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray1}" />
   <Setter Property="Background" Value="{DynamicResource ColorBrushWhite}" />
   <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray6}" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Margin" Value="0,0,8,8" />
   <Setter Property="MinHeight" Value="70" />
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="RadioButton">
      <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="12,10">
       <Grid>
        <ContentPresenter Margin="0,0,18,0" VerticalAlignment="Center" />
        <TextBlock x:Name="Tick" Text="✓" Visibility="Collapsed" FontWeight="Bold" Foreground="{DynamicResource ColorBrush2}" HorizontalAlignment="Right" VerticalAlignment="Center" />
       </Grid>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ColorBrush3}" /></Trigger>
       <Trigger Property="IsChecked" Value="True">
        <Setter TargetName="Frame" Property="Background" Value="{DynamicResource ColorBrush8}" />
        <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ColorBrush2}" />
        <Setter TargetName="Frame" Property="BorderThickness" Value="2" />
        <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
       </Trigger>
       <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource ColorBrush2}" /></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
 </UserControl.Resources>
 <StackPanel>
  <local:MyCard Margin="0,0,0,15">
   <StackPanel Margin="20,18">
    <DockPanel>
     <Border x:Name="ClubOnlineBadge" DockPanel.Dock="Right" Margin="12,0,0,0" Padding="10,4" Background="{DynamicResource ColorBrush8}" CornerRadius="6"
             ToolTip="选择服务器后显示该入口返回的在线数据。">
      <StackPanel>
       <TextBlock Text="所选入口在线" FontSize="11" HorizontalAlignment="Center" Opacity="0.75" />
       <TextBlock x:Name="ClubOnlineCount" Text="未知" FontSize="20" FontWeight="SemiBold" HorizontalAlignment="Center" />
      </StackPanel>
     </Border>
     <Image Source="/Plain Craft Launcher 2;component/Images/Wzbc/club-logo.png" Width="48" Height="48" Margin="0,0,12,0" RenderOptions.BitmapScalingMode="NearestNeighbor" />
     <StackPanel VerticalAlignment="Center">
      <TextBlock Text="{DynamicResource Conduit.Brand.Name}" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" />
      <TextBlock Text="从校园到方块，一起创造我们的世界" Margin="0,4,0,0" TextWrapping="Wrap" />
     </StackPanel>
    </DockPanel>
    <WrapPanel Margin="0,14,0,0">
     <local:MyButton Text="社团官网" Height="32" Margin="0,0,8,4" Padding="12,0" local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://wzbcmc.cn/" />
     <local:MyButton Text="登录与入服指南" Height="32" Margin="0,0,8,4" Padding="12,0" local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://wzbcmc.cn/servers.html" />
     <local:MyButton Text="社团更新日志" Height="32" Margin="0,0,8,4" Padding="12,0" Click="ShowHistory_Click" />
     <local:MyButton Text="社团皮肤站" Height="32" Margin="0,0,8,4" Padding="12,0" local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://skin.wzbcmc.cn/" />
     <local:MyButton Text="校园地图" Height="32" Margin="0,0,8,4" Padding="12,0" local:CustomEventService.EventType="OpenUrl" local:CustomEventService.EventData="https://wzbcmc.cn/campus-maps/2d/" />
     <TextBlock Text="QQ群 788564340" VerticalAlignment="Center" FontSize="12" />
    </WrapPanel>
   </StackPanel>
  </local:MyCard>
  <local:MyCard Title="启动后前往" Margin="0,0,0,15">
   <StackPanel Margin="20,40,12,18">
    <ItemsControl x:Name="Servers">
     <ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     <ItemsControl.ItemTemplate><DataTemplate>
      <RadioButton GroupName="ClubDestination" Tag="{Binding Id}" IsChecked="{Binding Selected, Mode=TwoWay}" Checked="Server_Checked"
                   Style="{StaticResource DestinationButton}" AutomationProperties.Name="{Binding Name}">
       <StackPanel>
        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" Opacity="0.75" />
       </StackPanel>
      </RadioButton>
     </DataTemplate></ItemsControl.ItemTemplate>
    </ItemsControl>
    <TextBlock x:Name="DestinationHint" FontWeight="SemiBold" Foreground="{DynamicResource ColorBrush2}" TextWrapping="Wrap" Margin="0,3,8,7" />

   </StackPanel>
  </local:MyCard>
 </StackPanel>
</UserControl>
