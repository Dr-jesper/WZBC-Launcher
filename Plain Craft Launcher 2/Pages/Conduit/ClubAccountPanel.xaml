<UserControl x:Class="PCL.ClubAccountPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL">
 <UserControl.Resources>  <Style x:Key="ClubActionButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
   <Setter Property="Background" Value="{DynamicResource ColorBrushWhite}" />
   <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush4}" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ColorBrush8}" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ColorBrush7}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
</UserControl.Resources>
 <StackPanel>
  <UniformGrid Columns="2" Margin="0,0,0,6">
   <Button x:Name="WzbcButton" Content="WZBC Skin (0)" Tag="wzbc" Click="Provider_Click" Style="{StaticResource ClubActionButton}" Height="34" Margin="0,0,3,3" FontSize="10" />
   <Button x:Name="MicrosoftButton" Content="Microsoft (0)" Tag="microsoft" Click="Provider_Click" Style="{StaticResource ClubActionButton}" Height="34" Margin="0,0,3,0" FontSize="10" />
   <Button x:Name="LittleButton" Content="LittleSkin (0)" Tag="littleskin" Click="Provider_Click" Style="{StaticResource ClubActionButton}" Height="34" Margin="0,0,3,0" FontSize="10" />
   <Button x:Name="MuaButton" Content="MUA (0)" Tag="mua" Click="Provider_Click" Style="{StaticResource ClubActionButton}" Height="34" FontSize="10" />
  </UniformGrid>
  <DockPanel Margin="0,2,0,4">
   <Button x:Name="AllButton" Content="全部" Tag="all" Click="Provider_Click" DockPanel.Dock="Right" Style="{StaticResource ClubActionButton}" Padding="6,2" FontSize="11" />
   <TextBlock x:Name="AccountSummary" FontWeight="SemiBold" VerticalAlignment="Center" />
  </DockPanel>
  <TextBlock x:Name="EmptyHint" Text="尚无此来源角色，请在下方登录。" FontSize="11" TextWrapping="Wrap" />
  <TextBlock Text="仅 Microsoft 登录路径核验 Minecraft 正版；皮肤站认证和离线档案不等于正版验证。" FontSize="10" TextWrapping="Wrap" Opacity="0.7" Margin="0,3,0,4" />
  <Grid x:Name="AccountActions" Margin="0,2,0,0">
   <Grid.ColumnDefinitions>
    <ColumnDefinition />
    <ColumnDefinition Width="Auto" />
    <ColumnDefinition Width="Auto" />
   </Grid.ColumnDefinitions>
   <local:MyComboBox x:Name="AccountSelector" Grid.Column="0" SelectionChanged="AccountSelector_SelectionChanged" MinHeight="32" MaxDropDownHeight="240" ToolTip="选择当前账户角色">
    <ComboBox.ItemTemplate>
     <DataTemplate>
      <StackPanel MaxWidth="270" ToolTip="{Binding Tooltip}">
       <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
       <TextBlock Text="{Binding Info}" FontSize="10" Opacity="0.7" TextTrimming="CharacterEllipsis" />
      </StackPanel>
     </DataTemplate>
    </ComboBox.ItemTemplate>
   </local:MyComboBox>
   <Button x:Name="AddAccountButton" Grid.Column="1" Content="+" ToolTip="添加账户" Click="Add_Click" Style="{StaticResource ClubActionButton}" Padding="7,0" Height="32" Margin="4,0,0,0" />
   <Button x:Name="RemoveSelectedButton" Grid.Column="2" Content="×" ToolTip="移除当前选中的账户" Click="RemoveSelectedButton_Click" Style="{StaticResource ClubActionButton}" Padding="7,0" Height="32" Margin="4,0,0,0" IsEnabled="False" />
  </Grid>
  <TextBlock x:Name="LoginStatus" FontSize="10" TextWrapping="Wrap" Margin="0,4" Opacity="0.7" Visibility="Collapsed" />
 </StackPanel>
</UserControl>
